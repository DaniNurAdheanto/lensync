# ==========================================
# CAMERA-TO-CLOUD (C2C) MONOREPO ENVIRONMENT
# ==========================================

# --- GENERAL ---
ENVIRONMENT=development
LOG_LEVEL=debug
APP_NAME=camera-to-cloud

# --- INFRASTRUCTURE: POSTGRESQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=c2c_db
POSTGRES_USER=c2c_user
POSTGRES_PASSWORD=c2c_secret_password
DATABASE_URL=postgres://c2c_user:c2c_secret_password@localhost:5432/c2c_db?sslmode=disable

# --- INFRASTRUCTURE: MINIO / S3 STORAGE ---
S3_ENDPOINT=localhost:9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=c2c-photos
S3_PUBLIC_URL=http://localhost:9000/c2c-photos

# --- INFRASTRUCTURE: REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- BACKEND SERVICE (services/api) ---
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET=super_secret_c2c_jwt_token_key_change_in_production_32bytes
JWT_EXPIRATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- DESKTOP AGENT (apps/desktop-agent) ---
AGENT_ID=agent-macbook-pro-m2
AGENT_NAME="Studio A - Tether Laptop"
AGENT_API_URL=http://localhost:8080/api/v1
AGENT_API_KEY=c2c_agent_test_api_key_12345
WATCH_DIRECTORY=/Users/photographer/Pictures/C2C_HotFolder
WATCH_POLL_INTERVAL_MS=1000
UPLOAD_CONCURRENCY=3
UPLOAD_MAX_RETRIES=5
CHUNK_SIZE_MB=8

# --- FRONTEND WEB (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME="Camera to Cloud"
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
